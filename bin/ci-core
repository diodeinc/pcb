#!/usr/bin/env bash
set -euo pipefail

# Native manufacturing and STEP libraries: no KiCad, compiler, GUI or network fixtures.
packages=(
  -p pcb-ir
  -p ipc2581
  -p gerberx2
  -p pcb-sexpr
  -p pcb-intern
  -p newstroke
  -p pcb-step
  -p pcb-ipc2581-tools
)
args=(--locked --no-default-features --features pcb-sexpr/serde "${packages[@]}")

cargo fmt "${packages[@]}" -- --check
cargo clippy "${args[@]}" --all-targets -- -D warnings
cargo nextest run "${args[@]}" --profile ci
cargo test "${args[@]}" --doc
