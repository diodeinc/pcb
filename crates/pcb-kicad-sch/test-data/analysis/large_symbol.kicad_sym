(kicad_symbol_lib
  (version 20251024)
  (generator pcb)
  (symbol "LARGE"
    (symbol "LARGE_1_1"
      (rectangle (start -2.54 -5.08) (end 2.54 5.08)
        (stroke (width 0) (type default)) (fill (type background)))
      (pin input line (at 5.08 -2.54 180) (length 2.54)
        (name "A") (number "1"))
      (pin input line (at 5.08 0 180) (length 2.54)
        (name "B") (number "2"))
      (pin input line (at 5.08 2.54 180) (length 2.54)
        (name "C") (number "3")))))
