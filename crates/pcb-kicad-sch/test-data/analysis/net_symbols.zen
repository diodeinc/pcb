"""Net-symbol reconciliation regression design."""

Project(name="NetSymbols", path="kicad", layout=False)

Resistor = Module("@stdlib/generics/Resistor.zen")

GROUND = io(Ground("GROUND"))
SIGNAL = Net("SIGNAL")

Resistor(name="R1", value="1kohms", package="0402", P1=GROUND, P2=SIGNAL)

