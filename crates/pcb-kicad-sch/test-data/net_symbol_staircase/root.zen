"""Two symbol-backed nets on one side of a component."""

Project(name="NetSymbolStaircase", path="kicad", layout=False)

GROUND_Z = io(Ground("GROUND_Z"))
GROUND_A = io(Ground("GROUND_A"))
GROUND_SHARED = io(Ground("GROUND_SHARED"))
GROUND_SPLIT = io(Ground("GROUND_SPLIT"))
INTERVENING_A = io(Net())
INTERVENING_B = io(Net())
VICTIM = io(Net())

Component(
    name="STAIR",
    footprint="Package_DIP:DIP-8_W7.62mm",
    symbol=Symbol(library="staircase.kicad_sym"),
    skip_bom=True,
    pins={
        "A": GROUND_Z,
        "B": GROUND_A,
        "C": GROUND_SHARED,
        "D": GROUND_SHARED,
        "E": GROUND_SHARED,
        "F": GROUND_SPLIT,
        "G": INTERVENING_A,
        "H": INTERVENING_B,
        "I": GROUND_SPLIT,
        "J": VICTIM,
    },
)

# pcb:sch STAIR x=50.0000 y=50.0000 rot=0
