"""Linked child interface with unused USB Type-C signals."""

Project(name="NestedNotConnected", path="kicad", layout=False)

load("@stdlib/interfaces.zen", "DiffPair", "Net", "Usb2", "Usb2TypeC")

Child = Module("nested_not_connected_child.zen")

USB_DP = Net("USB_DP")
USB_DN = Net("USB_DN")
USB_CC1 = Net("USB_CC1")
USB_CC2 = Net("USB_CC2")
USB2 = Usb2(D=DiffPair(P=USB_DP, N=USB_DN))
USB_C = Usb2TypeC(usb2=USB2, CC1=USB_CC1, CC2=USB_CC2)

Child(name="CHILD", USB=USB_C)
