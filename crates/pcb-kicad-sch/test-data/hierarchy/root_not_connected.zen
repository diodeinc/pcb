"""root.zen with FILTER_A's output explicitly left unconnected."""

Project(name="Hierarchy", path="kicad", layout=False)

Filter = Module("filter.zen")

SOURCE = Net("SOURCE")
MID = Net("MID")
SINK = Net("SINK")

Filter(name="FILTER_A", resistance="1kohms", INPUT=SOURCE, OUTPUT=NotConnected())
Filter(name="FILTER_B", resistance="2kohms", INPUT=MID, OUTPUT=SINK)
