"""Power net shared by a root component and a linked child module."""

Project(name="PowerHierarchy", path="kicad", layout=False)

Filter = Module("filter.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

POWER = io(Power("POWER"))
GROUND = io(Ground("GROUND"))
RETURN = Net("RETURN")

Resistor(name="R_ROOT", value="1kohms", package="0402", P1=POWER, P2=RETURN)
Filter(name="CHILD", resistance="2kohms", INPUT=POWER, OUTPUT=GROUND)
