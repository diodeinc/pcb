"""sheet_port_external.zen with the sheet port renamed from INPUT to IN."""

Project(name="SheetPort", path="kicad", layout=False)

Resistor = Module("@stdlib/generics/Resistor.zen")
Filter = Module("filter_in.zen")

SIGNAL = Net("SIGNAL")
ROOT_A = Net("ROOT_A")
ROOT_B = Net("ROOT_B")
SHEET_ONLY = Net("SHEET_ONLY")

Resistor(name="R1", value="1kohms", package="0402", P1=ROOT_A, P2=ROOT_B)
Resistor(name="R2", value="1kohms", package="0402", P1=SIGNAL, P2=ROOT_B)
Filter(name="FILTER", resistance="1kohms", IN=SIGNAL, OUTPUT=SHEET_ONLY)
