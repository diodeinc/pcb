"""A module sheet gains a part on a net that none of its sheet pins carry."""

Project(name="Hierarchy", path="kicad", layout=False)

Filter = Module("sheetless_filter.zen")

SOURCE = Net("SOURCE")
MID = Net("MID")
SINK = Net("SINK")

Filter(name="FILTER_A", resistance="1kohms", INPUT=SOURCE, OUTPUT=MID, EXTRA=SINK, bridged=True)
Filter(name="FILTER_B", resistance="2kohms", INPUT=MID, OUTPUT=SINK, swapped=True)
