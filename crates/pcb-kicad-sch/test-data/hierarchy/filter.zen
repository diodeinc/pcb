"""Linked child schematic with instance-specific configuration."""

Project(name="Filter", path="kicad", layout=False)

Resistor = Module("@stdlib/generics/Resistor.zen")

resistance = config("resistance", str)
INPUT = io("INPUT", Net, direction="input")
OUTPUT = io("OUTPUT", Net, direction="output")

Resistor(name="R1", value=resistance, package="0402", P1=INPUT, P2=OUTPUT)
