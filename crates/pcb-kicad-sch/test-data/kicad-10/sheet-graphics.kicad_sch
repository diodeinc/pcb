(kicad_sch (version 20260306) (generator eeschema)
  (uuid "graphics-page") (paper "A4") (lib_symbols)
  (rectangle (start 30.000 30) (end 120 70)
    (stroke (width 0.25) (type default) (color 40 90 150 1))
    (fill (type color) (color 225 238 250 1)) (uuid "block"))
  (text "USB-C sink: 5 V input, CC pull-downs, ESD"
    (exclude_from_sim no) (at 33 34 0)
    (effects (font (size 2 2) (thickness 0.3) (bold yes) (color 40 90 150 1))
      (justify left top)) (uuid "title"))
  (text "Free text survives save/reload\nSecond line, italic"
    (at 33 45 22.5) (effects (font (size 1.5 1.5) (italic yes) (line_spacing 1.2))
      (justify right bottom)) (uuid "multiline"))
  (polyline (pts (xy 34 61) (xy 48 61) (xy 48 55) (xy 60 55))
    (stroke (width 0.3) (type dash) (color 150 60 30 1))
    (fill (type none)) (uuid polyline))
  (circle (center 76 58) (radius 6)
    (stroke (width 0.25) (type dot) (color 40 90 150 1))
    (fill (type none)) (uuid "circle"))
  (arc (start 92 61) (mid 99 54) (end 106 61)
    (stroke (width 0.3) (type solid) (color 150 60 30 1))
    (fill (type color) (color 250 225 200 1)) (uuid "arc"))
  (text_box "Text box:  this note wraps inside the box and keeps its margins."
    (at 30 78 0) (size 60 23) (margins 2 2 2 2)
    (stroke (width 0.25) (type dash) (color 40 90 150 1))
    (fill (type color) (color 235 245 235 1))
    (effects (font (size 2 2)) (justify left top)) (uuid "text-box"))
  (text_box "ROTATED NOTE" (at 102 78 90) (size 18 23) (margins 2 2 2 2)
    (stroke (width -1)) (fill (type none))
    (effects (font (size 1.5 1.5))) (uuid "rotated"))
  (text "HIDDEN" (at 40 40 0)
    (effects (font (size 2 2)) hide (extension (at 5 6))) (uuid "hidden"))
  (wire (pts (xy 35 110) (xy 90 110))
    (stroke (width 0) (type default)) (uuid "wire"))
  (label "Electrical items still render" (at 35 110 0)
    (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "label"))
  (image (at 17.000 19) (scale 1) (uuid "opaque-image") (data "opaque bytes"))
  (sheet_instances (path "/" (page "1"))))
