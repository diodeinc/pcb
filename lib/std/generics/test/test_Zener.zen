"""Smoke test all Zener variants."""

load("../../interfaces.zen", "Net")

Zener = Module("../Zener.zen")


def _sanitize(value):
    return str(value).replace("-", "_")


for package in Zener.Package.values():
    name = "D_ZENER_" + _sanitize(package)
    Zener(
        name=name,
        package=package,
        zener_voltage="5.1V",
        power="500mW",
        A=Net(name + "_A"),
        K=Net(name + "_K"),
    )

# Power is optional.
Zener(
    name="D_ZENER_NO_POWER",
    package="SOD-123",
    zener_voltage="5.1V",
    A=Net("D_ZENER_NO_POWER_A"),
    K=Net("D_ZENER_NO_POWER_K"),
)
