"""Comprehensive test for Inductor component."""

load("../../interfaces.zen", "Net")

Inductor = Module("../Inductor.zen")

# Test all Package values.
for package in Inductor.Package.values():
    name = "L_" + str(package)
    Inductor(
        name=name,
        value="10uH",
        current="1A",
        mpn="TEST-" + name,
        manufacturer="Test",
        package=package,
        P1=Net(name + "_P1"),
        P2=Net(name + "_P2"),
    )
