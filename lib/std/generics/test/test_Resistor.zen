"""Comprehensive test for Resistor component."""

load("../../interfaces.zen", "Net")

Resistor = Module("../Resistor.zen")

# Test all Package values
for package in Resistor.Package.values():
    name = "R_" + str(package)
    Resistor(
        name=name,
        value="10kOhm",
        voltage="50V",
        package=package,
        mpn="TEST-" + name,
        manufacturer="Test",
        P1=Net(name + "_P1"),
        P2=Net(name + "_P2"),
    )

name = "R_US"
Resistor(
    name=name,
    value="10kOhm",
    voltage="50V",
    package="0603",
    use_us_symbol=True,
    mpn="TEST-" + name,
    manufacturer="Test",
    P1=Net(name + "_P1"),
    P2=Net(name + "_P2"),
)
