"""Smoke test all Rectifier variants."""

load("../../interfaces.zen", "Net")

Rectifier = Module("../Rectifier.zen")


def _sanitize(value):
    return str(value).replace("-", "_").replace(".", "p")


for technology in Rectifier.Technology.values():
    for package in Rectifier.Package.values():
        name = "D_RECT_" + _sanitize(technology) + "_" + _sanitize(package)
        Rectifier(
            name=name,
            package=package,
            technology=technology,
            reverse_voltage="100V",
            forward_current="100mA",
            A=Net(name + "_A"),
            K=Net(name + "_K"),
        )
