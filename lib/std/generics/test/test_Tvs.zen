"""Smoke test all TVS diode variants."""

load("../../interfaces.zen", "Ground", "Net", "Power")
load("../../units.zen", "Voltage")

Tvs = Module("../Tvs.zen")

gnd = Ground("GND")


def _sanitize(value):
    return str(value).replace("-", "_")


def _power_net(name, voltage):
    return Power(name + "_VCC", voltage=Voltage(voltage))


for direction in Tvs.Direction.values():
    for package in Tvs.Package.values():
        name = "D_TVS_" + _sanitize(direction) + "_" + _sanitize(package)
        if direction.value == "Unidirectional":
            a = gnd
            k = _power_net(name, "5V")
        else:
            a = Net(name + "_A")
            k = Net(name + "_K")
        Tvs(
            name=name,
            package=package,
            direction=direction,
            reverse_standoff_voltage="5V",
            reverse_clamping_voltage="12V",
            A=a,
            K=k,
        )

# A clamping-voltage range expresses the acceptable catalog range. Its upper
# bound must also be used by the component's voltage validation.
Tvs(
    name="D_TVS_CLAMP_RANGE",
    package="DO-214AC",
    reverse_standoff_voltage="33V",
    reverse_clamping_voltage="0V to 60V",
    A=gnd,
    K=_power_net("D_TVS_CLAMP_RANGE", "33V"),
)

# Optional API-facing constraints remain supported.
Tvs(
    name="D_TVS_CONSTRAINED",
    package="SOD-882",
    direction="Bidirectional",
    reverse_standoff_voltage="5V",
    reverse_clamping_voltage="12V",
    peak_pulse_power="100W",
    capacitance="1pF",
    A=Net("D_TVS_CONSTRAINED_A"),
    K=Net("D_TVS_CONSTRAINED_K"),
)
