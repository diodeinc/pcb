Size = enum("5mm", "8mm", "10mm")

size = config(Size, default=Size("5mm"), optional=True, help="2D barcode size")
properties = {
    "value": "QR_" + size.value,
    "size": size,
}


def _footprint(size: Size) -> str:
    return "./footprints/QR_" + size.value + ".kicad_mod"


Component(
    name="QR",
    prefix="QR",
    symbol=Symbol("./symbols/QR.kicad_sym"),
    footprint=File(_footprint(size)),
    pins={},
    properties=properties,
    skip_bom=True,
    skip_pos=True,
)
