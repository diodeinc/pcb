#!/usr/bin/env bash
# Post-clone orb setup for the pcb repo. Runs before the agent starts.
# See https://ampcode.com/manual/orbs for the contract.
set -euo pipefail

SECONDS=0

log() {
  printf '[orb setup %s +%ss] %s\n' "$(date -Is)" "$SECONDS" "$*" >&2
}

# rust-toolchain.toml selects the repository's pinned toolchain here.
log 'Installing Rust components'
rustup component add clippy rustfmt
log 'Installed Rust components'
log "Orb setup complete in ${SECONDS}s"
